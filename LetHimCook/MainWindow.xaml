<Window x:Class="LetHimCook.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LetHimCook"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">

    <Grid>
        <Frame x:Name="MainFrame"/>

        <Border Width="80" HorizontalAlignment="Left" Background="Transparent">
            <Border x:Name="NavPanel" Background="Gray" CornerRadius="0,15,15,0" Width="60" HorizontalAlignment="Left">
                <Border.RenderTransform>
                    <TranslateTransform X="-50"/>
                </Border.RenderTransform>
                <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Style="{StaticResource IconButton}" Click="MainButt_Click" Tag="1" Margin="0,10,0,10">
                        <Image Source="/res/home.png"/>
                    </Button>
                    <Button  Style="{StaticResource IconButton}" Click="MainButt_Click" Tag="2" Margin="0,10,0,10">
                        <Image Source="/res/edit.png"/>
                    </Button>
                    <Button Style="{StaticResource IconButton}" Click="MainButt_Click" Tag="3" Margin="0,10,0,10">
                        <Image Source="/res/account.png"/>
                    </Button>
                </StackPanel>
            </Border>
            <Border.Triggers>
                <EventTrigger RoutedEvent="Mouse.MouseEnter">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="NavPanel" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                             To="0" Duration="0:0:0.3">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>

                <EventTrigger RoutedEvent="Mouse.MouseLeave">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="NavPanel" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                             To="-50" Duration="0:0:0.3">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Border.Triggers>
            
        </Border>
    </Grid>
</Window>
