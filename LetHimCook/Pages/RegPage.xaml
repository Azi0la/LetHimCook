<Page x:Class="LetHimCook.Pages.RegPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:LetHimCook.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="RegPage"
      Background="{DynamicResource WindowBackgroundBrush}">

    <Grid>
        <Border
                Style="{StaticResource Border1}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="275"
                Height="350"
                CornerRadius="15">

            <StackPanel>
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                   Text="Let Him Cook" FontSize="30"/>
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
            Text="Регистрация" FontSize="24" Margin="0,0,0,15"/>
                <WrapPanel HorizontalAlignment="Center">
                    <TextBlock Text="Логин:" FontSize="18"/>
                    <TextBox x:Name="LoginTB" Width="225" Height="30"/>
                </WrapPanel>
                <WrapPanel HorizontalAlignment="Center">
                    <TextBlock Text="Пароль:" FontSize="18"/>
                    <PasswordBox x:Name="PassTB" Width="225" Height="30"/>
                </WrapPanel>
                <WrapPanel HorizontalAlignment="Center">
                    <TextBlock Text="Повтор пароля:" FontSize="18"/>
                    <PasswordBox x:Name="PassDubTB" Width="225" Height="30"/>
                </WrapPanel>
                <Button x:Name="RegButt" Width="110" Height="40" Content="Регистрация" Margin="10" Click="RegButt_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
