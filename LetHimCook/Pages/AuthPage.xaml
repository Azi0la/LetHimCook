<Page x:Class="LetHimCook.Pages.AuthPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:LetHimCook.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AuthPage"
      Background="{DynamicResource WindowBackgroundBrush}">

    <Grid>
        <Border
            Style="{StaticResource Border1}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Width="275"
            Height="325"
            CornerRadius="15">

            <StackPanel>
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                           Text="Let Him Cook" FontSize="30"/>
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                    Text="Авторизация" FontSize="24" Margin="0,0,0,15"/>
                <WrapPanel HorizontalAlignment="Center">
                    <TextBlock Text="Логин:" FontSize="18"/>
                    <TextBox x:Name="LoginTB" Width="225" Height="30"/>
                </WrapPanel>
                <WrapPanel HorizontalAlignment="Center">
                    <TextBlock Text="Пароль:" FontSize="18"/>
                    <PasswordBox x:Name="PassTB" Width="225" Height="30"/>
                </WrapPanel>
                <Button x:Name="AuthButt" Width="100" Height="40" Content="Войти" Margin="10"/>
                <Button x:Name="ForgotButt" Width="115" Content="Нет аккаунта?" Background="Transparent"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
